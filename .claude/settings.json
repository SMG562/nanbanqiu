{
  "permissions": {
    "allow": [
      "Bash(git clone:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -c user.name=Claude -c user.email=noreply@anthropic.com commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(bash tests/lib/ci_status.sh:*)",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__remote-devices__device_commit_files",
      "mcp__remote-devices__device_list_dir"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'me=$(gh api user --jq .login 2>/dev/null || echo ?); [ \"$me\" = SMG562 ] && r=所有者 || r=协作者; echo \"身份：gh 账号 $me = 对话里的人（$r），不要再问；步骤只写 $r 能做的\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/role_guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
