{
  "permissions": {
    "allow": [
      "Bash(git clone:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -c user.name=Claude -c user.email=noreply@anthropic.com commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(bash tests/lib/ci_status.sh:*)",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__remote-devices__device_commit_files",
      "mcp__remote-devices__device_list_dir",
      "Bash(gh api -X POST repos/SMG562/nanbanqiu/issues/:*)",
      "Bash(gh api -X PATCH repos/SMG562/nanbanqiu/issues/:*)",
      "Bash(gh api -X POST repos/SMG562/nanbanqiu/pulls:*)",
      "Bash(bash tools/handoff_check.sh:*)",
      "Bash(bash tools/new_branch.sh:*)",
      "Bash(bash tools/pr_say.sh:*)",
      "Bash(bash tools/pr_state.sh:*)",
      "Bash(bash tools/pr_merge.sh:*)",
      "Bash(bash tools/ci_wait.sh:*)",
      "Bash(bash tools/gate.sh:*)",
      "Bash(bash tools/sync_main.sh:*)",
      "Bash(node tests/run_all.mjs:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api -X PUT repos/SMG562/nanbanqiu/pulls/:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'me=$(gh api user --jq .login 2>/dev/null || echo ?); if [ \"$me\" = SMG562 ]; then r=所有者; elif git show origin/main:.github/CO_OWNERS 2>/dev/null | grep -qxF \"$me\"; then r=共同所有者; else r=协作者; fi; echo \"身份：gh 账号 $me = 对话里的人（$r），不要再问；步骤只写 $r 能做的\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/role_guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
