#!/usr/bin/env bash
# 推送前护栏（11-03 事故后加）：往 main 推的提交一次删掉 10 个以上文件 = 几乎一定是出错了（比如测试临时仓库的提交泄漏），直接拦下。
# 确实要这么做：git push --no-verify，并在提交信息里写原因。
# 11-12：不改写远端历史（强推）、不删远端分支——按「结果」拦而不是按参数名拦：远端现有提交不是推送内容的祖先 = 改写历史，不管写成 -f / --force-with-lease / +分支。
# 来历：我手写推送命令时带了强制参数（被工具权限拦下，没执行）。多层防线之一；确实需要：NBQ_REWRITE="原因" git push …（原因会打印，请同时写进提交信息 / PR）。
# 本地缺远端那个提交（浅克隆没抓到）时验证不了，同样拦下：先 git fetch 再推。
Z=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  case "$rref" in refs/heads/*)
    why=""
    if [ "$lsha" = "$Z" ]; then why="删除远端分支 ${rref#refs/heads/}"
    elif [ "$rsha" != "$Z" ] && [ "$rsha" != "$lsha" ]; then
      git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || why="改写远端历史（远端 ${rsha:0:7} 不是要推的提交的祖先，或本地没有它：先 git fetch）：${rref#refs/heads/}"
    fi
    if [ -n "$why" ]; then
      if [ -n "$NBQ_REWRITE" ]; then echo "改写 / 删除远端历史，原因：$NBQ_REWRITE（$why）"
      else echo "推送被拦下：这次会$why。普通推送不会这样；确实需要请 NBQ_REWRITE=\"原因\" git push …"; exit 1; fi
    fi ;;
  esac
  [ "$rref" = "refs/heads/main" ] || continue
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  base="$rsha"; [ "$base" = "0000000000000000000000000000000000000000" ] && continue
  git cat-file -e "$base^{commit}" 2>/dev/null || continue
  n=$(git diff --diff-filter=D --name-only "$base" "$lsha" | wc -l)
  if [ "$n" -ge 10 ]; then echo "推送被拦下：这次推到 main 会删掉 $n 个文件（前 5 个：$(git diff --diff-filter=D --name-only "$base" "$lsha" | head -5 | tr '\n' ' ')）。如果不是有意的，先查提交内容。"; exit 1; fi
  # 11-05：推到 main 的提交改了代码（不含文档 / 宣传图 / 进度记录）→ 必须有「相关测试全绿」的戳且对的是这个提交的内容（node tests/run_all.mjs --changed=origin/main 跑完全绿、工作区干净时自动盖）。
  # 来历：11-05 我没等 --changed 跑完就推了，结果它抓到的 real_chat 红已经在 main 上。纪律写在 skill 里拦不住赶时间，改成机器拦。
  # 确实只改了测试 / 工具之外的东西或环境跑不了：NBQ_UNTESTED="原因" git push（原因会打印，请同时写进提交信息）。
  if [ -n "$(git diff --name-only "$base" "$lsha" -- . ':!marketing' ':!*.md' ':!*.png' ':!*.jpg')" ]; then
    stamp=$(cat "$(git rev-parse --git-dir)/nbq_changed_ok" 2>/dev/null); want=$(git rev-parse "$lsha^{tree}")
    if [ "$stamp" != "$want" ]; then
      if [ -n "$NBQ_UNTESTED" ]; then echo "未跑相关测试就推送，原因：$NBQ_UNTESTED";
      else echo "推送被拦下：这次推到 main 的提交改了代码，但没有对应的「相关测试全绿」记录。先跑 node tests/run_all.mjs --changed=origin/main（要等它跑完且全绿；工作区要干净），再推。"; exit 1; fi
    fi
  fi
  # 随做随写（11-04）：这次推到 main 的提交改了代码（不含宣传图、文档），进度记录却没跟着改 → 提醒（不拦）。用户随时会开新对话，记录要跟上。
  if [ -n "$(git diff --name-only "$base" "$lsha" -- . ':!marketing' ':!*.md')" ] && [ -z "$(git diff --name-only "$base" "$lsha" -- 进度记录.md)" ]; then
    echo "提醒：这次推送改了代码，但 进度记录.md 没更新。如果状态变了（合并、部署、用户拍板、下一步变了），现在就补一行再推。"; fi
done
exit 0
