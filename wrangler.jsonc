// 预览网站（Cloudflare Workers + 静态资源）：构建命令 `node tools/site.mjs` 生成 site/，部署命令 `npx wrangler deploy`。
// 只发布 site/ 里的文件（白名单见 tools/site.mjs）；_headers 在 site/ 里（禁止收录、不缓存）。
// worker/index.mjs 只接管 /g/码、/p/编号（微信等抓链接时返回这个球局自己的卡片信息），其余全交给静态资源。
{
  "name": "nanbanqiu",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/g/*", "/p/*"]
  }
}
